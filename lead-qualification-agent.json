      "name": "Hot: finalise"
    },
    {
      "parameters": {
        "jsCode": "// Prepare log row: one clean row per lead, whatever path it took\nreturn $input.all().map(({ json: d }) => {\n  let status = 'success';\n  if (d.valid === false) status = d.isSpam ? 'rejected_spam' : 'rejected_invalid';\n  else if (!['Hot', 'Warm', 'Cold'].includes(d.tier)) status = 'unrouted';\n  else if (d.aiStatus === 'failed') status = 'success_ai_fallback';\n\n  return {\n    json: {\n      runId: String(d.runId ?? $execution.id),\n      submittedAt: d.submittedAt || '',\n      name: d.name || '',\n      email: d.email || '',\n      company: d.company || '',\n      need: (d.need || '').slice(0, 500),\n      budget: d.budget || '',\n      timeline: d.timeline || '',\n      teamSize: d.teamSize || '',\n      ruleScore: d.ruleScore ?? null,\n      fitScore: d.fitScore ?? null,\n      tier: d.tier || '',\n      aiStatus: d.aiStatus || 'skipped',\n      action: d.action || 'none',\n      actionStatus: d.actionStatus || '',\n      latencyMs: d.latencyMs ?? (Date.now() - d.startedAt),\n      status,\n    },\n  };\n});"
      },
