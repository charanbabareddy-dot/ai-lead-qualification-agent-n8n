    },
    {
      "parameters": {
        "jsCode": "// Hot: finalise, apply the human decision\nconst lead = $('Hot: alert').first().json;\nconst f = $input.first().json;\n\nconst decision = f['Decision'];\nconst edited = (f['Edited reply'] || '').trim();\n\nlet actionStatus;\nif (!decision) actionStatus = 'no response in 48h';\nelse if (decision === 'Approve') actionStatus = 'approved';\nelse actionStatus = 'rejected';\n\nreturn [{\n  json: {\n    ...lead,\n    actionStatus,\n    message: actionStatus === 'approved' ? (edited || lead.draftReply) : '',\n    humanEdited: edited !== '',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
