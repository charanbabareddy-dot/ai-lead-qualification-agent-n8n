      "id": "bd4b432e-910e-4d75-a4b2-6213af08fbc8",
      "name": "Fetch homepage",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Rule score: plain code for facts, no AI\nconst lead = $('Input checks').first().json;   // lead data from earlier node\nconst http = $input.first().json;              // homepage fetch result\n\n// 1. Clean the homepage text\nlet homepageText = '';\nlet homepageStatus = 'ok';\nif (!lead.website) {\n  homepageStatus = 'no website';\n} else if (http.error) {\n  homepageStatus = 'fetch failed';\n} else {\n  homepageText = String(http.data || '')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 3000);\n  if (!homepageText) homepageStatus = 'empty page';\n}\n\n// 2. Points tables (must match the form options exactly)\nconst budgetPoints = {\n  'Under ₹10,000': 0,\n  '₹10,000 to ₹50,000': 15,\n  '₹50,000 to ₹2,00,000': 35,\n  'Above ₹2,00,000': 40,\n  'Not sure': 10,\n};\nconst timelinePoints = {\n  'This month': 30,\n  '1 to 3 months': 25,\n  '3 to 6 months': 12,\n  'Just exploring': 0,\n};\nconst teamPoints = {\n  '1 to 10': 0,\n  '11 to 50': 12,\n  '51 to 200': 25,\n  '201 to 1,000': 30,\n  '1,000+': 20,\n};\n\nconst flags = [];\nconst pick = (table, value, label) => {\n  if (value in table) return table[value];\n  flags.push('unknown ' + label + ' value: ' + value);  // catches spelling mismatches\n  return 0;\n};\n\n// 3. Calculate the score\nlet ruleScore =\n  pick(budgetPoints, lead.budget, 'budget') +\n  pick(timelinePoints, lead.timeline, 'timeline') +\n  pick(teamPoints, lead.teamSize, 'team size');\n\nif (lead.freeEmail) {\n  ruleScore -= 10;\n  flags.push('free email domain');\n}\nif (lead.budget === 'Above ₹2,00,000' && lead.timeline === 'Just exploring') {\n  flags.push('big budget but no timeline');\n}\nruleScore = Math.max(0, Math.min(100, ruleScore));\n\nreturn [{\n  json: {\n    ...lead,\n    homepageStatus,\n    homepageText,\n    ruleScore,\n    ruleFlags: flags,\n  },\n}];"
      },
