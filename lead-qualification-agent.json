    {
      "parameters": {
        "jsCode": "// Input checks: plain rules, no AI\nconst f = $input.first().json;\nconst clean = (v) => (v ?? '').toString().trim();\n\n// 1. Clean the data and use short names\nconst lead = {\n  name: clean(f['Name']),\n  email: clean(f['Work email']).toLowerCase(),\n  company: clean(f['Company name']),\n  website: clean(f['Company website']),\n  need: clean(f['What do you need help with?']),\n  budget: clean(f['Budget per month']),\n  timeline: clean(f['Timeline']),\n  teamSize: clean(f['Team size']),\n  submittedAt: f.submittedAt,\n};\n\n// Add https:// to the website if the lead did not type it\nif (lead.website && !/^https?:\\/\\//i.test(lead.website)) {\n  lead.website = 'https://' + lead.website;\n}\n\nconst problems = [];\n\n// 2. Required fields (website is optional)\nfor (const key of ['name', 'email', 'company', 'need', 'budget', 'timeline', 'teamSize']) {\n  if (!lead[key]) problems.push('missing ' + key);\n}\n\n// 3. Email format\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(lead.email);\nif (lead.email && !emailOk) problems.push('invalid email format');\n\n// Free email check (not spam, but a weaker B2B signal)\nconst freeDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'rediffmail.com'];\nconst emailDomain = lead.email.split('@')[1] || '';\nconst freeEmail = freeDomains.includes(emailDomain);\n\n// 4. Spam filter\nconst spamWords = ['crypto', 'bitcoin', 'casino', 'loan offer', 'seo services', 'backlinks', 'guest post'];\nconst text = (lead.name + ' ' + lead.company + ' ' + lead.need).toLowerCase();\nconst spamHits = spamWords.filter((w) => text.includes(w));\nconst linkCount = (lead.need.match(/https?:\\/\\//g) || []).length;\nconst isSpam = spamHits.length > 0 || linkCount >= 2;\n\nreturn [{\n  json: {\n    runId: $execution.id,\n    startedAt: Date.now(),\n    ...lead,\n    freeEmail,\n    isSpam,\n    spamHits,\n    problems,\n    valid: problems.length === 0 && !isSpam,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
