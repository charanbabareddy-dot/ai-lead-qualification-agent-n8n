    {
      "parameters": {
        "jsCode": "// Format error: turn n8n's error info into one log row\nconst e = $input.first().json;\nreturn [{\n  json: {\n    errorTime: new Date().toISOString(),\n    workflowName: e.workflow?.name || 'unknown',\n    executionId: String(e.execution?.id ?? 'unknown'),\n    failedNode: e.execution?.lastNodeExecuted || 'unknown',\n    errorMessage: (e.execution?.error?.message || 'no message').slice(0, 500),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
